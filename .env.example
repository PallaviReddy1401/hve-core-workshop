SMARTASSIST_MODEL_PROVIDER=stub
SMARTASSIST_SESSION_TTL_SECONDS=1800
SMARTASSIST_MAX_MESSAGE_LENGTH=4000
SMARTASSIST_ROUTING_MINIMUM_CONFIDENCE=0.7

# Required only when SMARTASSIST_MODEL_PROVIDER=foundry
SMARTASSIST_FOUNDRY_PROJECT_ENDPOINT=
SMARTASSIST_FOUNDRY_MODEL_DEPLOYMENT_NAME=

# Optional: used by the local evaluation script for Azure OpenAI judging
SMARTASSIST_AZURE_OPENAI_ENDPOINT=
SMARTASSIST_AZURE_OPENAI_DEPLOYMENT=
SMARTASSIST_AZURE_OPENAI_API_VERSION=2024-10-21
SMARTASSIST_AZURE_OPENAI_API_KEY=

# Used by DefaultAzureCredential when tenant selection is required
AZURE_TENANT_ID=
